@m=object statue
@m column 1
1.	gu₃-de₂-a
#lem: Gudea[1]RN

2.	ensi₂
#lem: ensik[ruler]

3.	lagaš{ki}
#lem: Lagaš[1]

4.	sipad zid inim gen₆-na
#lem: sipad[shepherd]; zid[right]; inim[word]; gin[establish]

5.	{d}nin-ŋir₂-su-ka-ke₄
#lem: Ninŋirsuk[1]DN

6.	lu₂ bi₃-lu₅-da diŋir-re-ne-ke₄
#lem: lu[person]; biluda[rituals]; diŋir[deity]

7.	si bi₂-sa₂-sa₂-a
#lem: si[horn]; sa[equal]

8.	ud# e₂-ninnu
#lem: ud[day]; Eninnu[1]TN

9.	[{d}]nin#-ŋir₂-su-ka
#lem: Ninŋirsuk[1]DN

@m column 2
1.	in-du₃-a-ta
#lem: du[build]

2.	nam-ha-ni gala-mah
#lem: Nammahni[1]PN; galamah[singer]

3.	<e₂>-munus-gil-sa!(E₂)-ka-ra
#lem: Emunusgilsak[1]TN

4.	kug-babbar zabar
#lem: kugbabbar[silver]; zabar[bronze]

5.	dupsik sahar-ra
#lem: dupsik[basket]; sahar[dust]

6.	u₃ niŋ₂ en-na ŋal₂-la-aš
#lem: u[and]; niŋ[thing]; enna[until]; ŋal[be]

7.	e₂-a-na lu₂ nu-ku₄(REC145)-ku₄(REC145)-de₃
#lem: e[house]; lu[person]; kur[enter]

8.	ama-ar-gi₄-bi mu-na#-[ŋar]
#lem: amargi[reversion]; ŋar[place] +.

9.	mu-bi-a 6(bur₃) NE@s E GABA ašag
#lem: mu[year]; n; u; u; u; ašag[field]

10.	inim mu-na-gen₆
#lem: inim[word]; gin[establish] +.

