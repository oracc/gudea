1.	nin dumu ki aŋ₂ an kug-ga-ke₄
#lem: nin[lady]; dumu[child]; ki[place]; aŋ[measure]; an[sky]; kug[pure]

2.	ama {d}ba-u₂
#lem: ama[mother]; Bau[1]DN

3.	e₂-tar-sir₂-sir₂-ta
#lem: Etarsirsir[1]TN

4.	gu₃-de₂-a
#lem: Gudea[1]RN

5.	nam#-til₃ mu-na-šum₂
#lem: namtil[life]; šum[give] +.

6.	mu-še₃ mu-na-še₂₁
#lem: mu[name]; še[call] +.

7.	e₂ iri-kug-ga-ka
