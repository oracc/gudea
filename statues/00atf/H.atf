9.	lagaš#{ki#}-ke₄
#lem: Lagaš[1]SN

@m column 2
1.	ud e₂-tar-sir₂-sir₂
#lem: ud[day]; Etarsirsir[1]TN

2.	e₂ ki aŋ₂-ni
#lem: e[house]; ki[place]; aŋ[measure]

3.	e₂ he₂-du₇ iri-kug-ga
#lem: e[house]; hedu[ornament]; Irikug[1]SN

4.	mu-na-du₃-a
#lem: !du[build]\a

5.	kur ma₂-gan{ki}-ta
#lem: kur[land]; Magan[1]GN

6.	{na₄}esi!(PA) im-ta-ed₃
#lem: esi[diorite]; ed[ascend\t] +.

7.	alan-na-ni-še₃
#lem: alan[statue]

